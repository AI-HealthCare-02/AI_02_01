# 가상환경 — 용량이 크고 각자 설치해야 함
venv/
.venv/
env/

# 환경변수 — API 키, DB 비밀번호 등 절대 올리면 안 됨
.env
.env.*

# Python 캐시 파일 — 자동 생성되는 불필요한 파일
__pycache__/
*.py[cod]
*.pyo
*.pyd

# 테스트/커버리지 결과
.pytest_cache/
.coverage
htmlcov/

# IDE 설정 파일
.vscode/
.idea/
*.DS_Store        # Mac 파일 탐색기 메타데이터

# 빌드 결과물
dist/
build/
*.egg-info/

# 로그 파일
*.log